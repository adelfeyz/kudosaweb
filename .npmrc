# Install @adelfeyz/* from GitHub Packages.
# Create a classic PAT with read:packages and set:
#   $env:NODE_AUTH_TOKEN = "<PAT>"
@adelfeyz:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Next/Turbopack needs transitive deps resolvable from the project root.
shamefully-hoist=true
public-hoist-pattern[]=*
