{
  "name": "raveshmand-api-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for Raveshmand unified API endpoints",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:api": "node scripts/test-api-endpoints.js",
    "test:migrate": "node scripts/migrate-database.js",
    "test:all": "npm run test:api && npm run test:integration"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240820.0",
    "@playwright/test": "^1.56.0",
    "wrangler": "^3.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "dotenv": "^16.3.0",
    "jest": "^29.5.0",
    "jest-environment-node": "^29.5.0",
    "playwright": "^1.40.0",
    "supertest": "^6.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/setup.js"
    ],
    "testMatch": [
      "<rootDir>/**/*.test.js",
      "<rootDir>/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "**/*.{js,ts}",
      "!**/node_modules/**",
      "!**/tests/**",
      "!**/coverage/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
