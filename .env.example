# Kudosa — local development environment
# Copy to .env.local and fill in values as needed.
#
# Local port map (avoid conflicts with sibling sites):
#   raveshmand   3010 / 3011
#   pointer      3020 / 3021
#   hadafsanj    3030 / 3031
#   crm-platform 3040 / 3041
#   kudosa       3050 / 3051

NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3051
NEXT_PUBLIC_SITE_URL=http://localhost:3050
NEXT_PUBLIC_APP_LOGIN_URL=https://kudosa.ir
APP_BASE_URL=http://localhost:3050
JWT_SECRET=your-local-secret-change-me
DB_PATH=./data/database.db
PORT=3051

# Local CRM login (username: admin)
ADMIN_PASSWORD=admin

# Optional — transactional email (contact forms, magic links)
# Without BREVO_API_KEY, magic links are logged to the API console.
BREVO_API_KEY=

# Optional — AI blog assistant
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional — analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SEARCH_CONSOLE_VERIFICATION=
