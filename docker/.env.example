# Raveshmand — Docker production environment
# Copy to docker/.env before running: docker compose up -d --build

JWT_SECRET=change-this-to-a-long-random-secret
SITE_URL=http://localhost:3000

# CRM login (username: admin) — change in production
ADMIN_PASSWORD=admin

# Optional — transactional email
BREVO_API_KEY=

# Optional — AI blog assistant
OPENAI_API_KEY=
OPENROUTER_API_KEY=
